# Server-side only. Never expose this key to the browser or commit a real value.
GROQ_API_KEY=

# Optional OpenAI-compatible provider configuration.
AETHERON_LLM_BASE_URL=https://api.groq.com/openai/v1
AETHERON_MODEL=openai/gpt-oss-20b

# Comma-separated exact browser origins.
AETHERON_ALLOWED_ORIGINS=http://localhost:3000,https://tanvirsparklegifts.github.io

# Early preview guard; use Redis-backed rate limiting and authentication for production.
AETHERON_CHAT_RPM_PER_IP=10
